{
  "quarry": {
    "color": {
      "slate": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.2, 0.2, 0.25] }
      }
    },
    "size": {
      "4": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } }
    }
  },
  "forge": {
    "color": {
      "fg": { "$type": "color", "$value": "{quarry.color.slate}" },
      "bg": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1] }
      }
    },
    "edge": {
      "$type": "border",
      "$value": {
        "color": "{quarry.color.slate}",
        "width": { "value": 1, "unit": "px" },
        "style": "solid"
      }
    }
  },
  "facade": {
    "gap": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
  },
  "loose": {
    "gap": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
  }
}
