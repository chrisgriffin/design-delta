# Prettier owns formatting everywhere but the paths below — see CLAUDE.md.

# npm owns these, and release-pr.yml rewrites both via `npm version` mid-release.
# Formatting them here would put CI and npm's writer in a fight on every release PR.
package.json
package-lock.json

# Generated by conventional-changelog — do not reformat
CHANGELOG.md

# Generated by scripts/generate-config-reference.mjs from
# schema/config.schema.json, checked in CI via that script's own --check flag
# (not Prettier's opinion) — reformatting here would put the two checks in a
# fight on every PR the same way package.json/package-lock.json would above.
docs/config-reference.md

# Generated by scripts/generate-rules-reference.mjs from the rule registries,
# checked in CI via that script's own --check flag — same reasoning as the
# config reference directly above.
docs/rules.md

# Build/scratch output (.gitignore'd, but Prettier doesn't read .gitignore, so
# a local `prettier --check .` after a coverage run would otherwise diverge
# from CI, which always runs on a clean checkout).
coverage/
tmp-*/

# Laid over a checkout at runtime by the build loop that runs this repo, and
# never tracked here: a laid checkout running `prettier --check .` would
# otherwise fail on files this repo does not own.
.agents/

# Spec Kit's .specify/ tree, laid the same way as .agents/ above.
.specify/
